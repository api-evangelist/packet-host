{
  "opencollection": "1.0.0",
  "info": {
    "name": "Metal Authentication PasswordResetTokens API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "PasswordResetTokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a password reset token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.equinix.com/metal/v1/reset-password",
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Email of user to create password reset token"
              }
            ]
          },
          "docs": "Creates a password reset token"
        },
        {
          "info": {
            "name": "Reset current user password",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.equinix.com/metal/v1/reset-password"
          },
          "docs": "Resets current user password."
        }
      ]
    }
  ],
  "bundled": true
}