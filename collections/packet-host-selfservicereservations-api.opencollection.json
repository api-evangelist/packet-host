          "http": {
            "method": "GET",
            "url": "https://api.equinix.com/metal/v1/projects/:project_id/self-service/reservations",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Items returned per page"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project UUID"
              },
              {
                "name": "categories",
                "value": "",
                "type": "query",
                "description": "Filter reservations by items category"
              }
            ]
          },
          "docs": "Returns all reservations."
        },
        {
          "info": {
            "name": "Create a reservation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.equinix.com/metal/v1/projects/:project_id/self-service/reservations",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project UUID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a reservation."
        },
        {
          "info": {
            "name": "Retrieve a reservation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.equinix.com/metal/v1/projects/:project_id/self-service/reservations/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Reservation short_id"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project UUID"
              }
            ]
          },
          "docs": "Returns a reservation"
        }
      ]
    }
  ],
  "bundled": true
}