{
  "opencollection": "1.0.0",
  "info": {
    "name": "Metal Authentication Firmware Sets API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Firmware Sets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Organization's Firmware Sets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.equinix.com/metal/v1/organizations/:id/firmware-sets",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Organization UUID"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "page number to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "items returned per page."
              }
            ]
          },
          "docs": "Returns all firmware sets associated with the organization."
        },
        {
          "info": {
            "name": "Get Project's Firmware Sets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.equinix.com/metal/v1/projects/:id/firmware-sets",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Project UUID"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "page number to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "items returned per page."
              }
            ]
          },
          "docs": "Returns all firmware sets associated with the project or organization."
        }
      ]
    }
  ],
  "bundled": true
}