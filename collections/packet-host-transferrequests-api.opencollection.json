{
  "opencollection": "1.0.0",
  "info": {
    "name": "Metal Authentication TransferRequests API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "TransferRequests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "View a transfer request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.equinix.com/metal/v1/transfers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Transfer request UUID"
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Nested attributes to include. Included objects will return their full\nattributes. Attribute names can be dotted (up to 3 levels) to included deeply\nnested objects."
              }
            ]
          },
          "docs": "Returns a single transfer request."
        },
        {
          "info": {
            "name": "Accept a transfer request",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.equinix.com/metal/v1/transfers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Transfer request UUID"
              }
            ]
          },
          "docs": "Accept a transfer request."
        },
        {
          "info": {
            "name": "Decline a transfer request",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.equinix.com/metal/v1/transfers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Transfer request UUID"
              }
            ]
          },
          "docs": "Decline a transfer request."
        }
      ]
    }
  ],
  "bundled": true
}